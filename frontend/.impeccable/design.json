  "narrative": {
    "northStar": "The Handoff Desk",
    "overview": "Relay feels like a calm, dependable desk for decisions about client email. Its civic wayfinding character comes from a deep blue frame, plainly labelled actions, aligned records, and a visible route from suggestion to ownership. The approved revision makes the working area warmer and the blue quieter than the initial comp.\n\nThe interface is compact and information rich without ornamental noise. Warm off-white separates the working ground from white records and detail surfaces. Citron appears where ownership needs review, so the exception stays easy to find. The navigation frame and action controls carry most of the visual weight.",
    "keyCharacteristics": [
      "Deep blue navigation with a warm off-white workspace.",
      "Compact, highly legible sans typography and orderly rows.",
      "Soft citron reserved for review and uncertain ownership.",
      "Thin borders, tonal layers, and almost no resting shadows."
    ],
    "rules": [
      { "name": "The Signal Rule", "body": "Use citron for unresolved review states; use blue for navigation, ownership, and action. Keep the signal rare enough to scan instantly.", "section": "colors" },
      { "name": "The Scan Rule", "body": "Put the decision bearing phrase in bold, then keep supporting context lighter and smaller. Use tabular numerals for counts and ages.", "section": "typography" },
      { "name": "The Flat Desk Rule", "body": "Use tonal layers and hairlines for ordinary content; reserve shadow for a surface that actually overlays another.", "section": "elevation" }
    ],
    "dos": [
      "Do keep the deep blue frame and warm working ground as the main visual relationship.",
      "Do make the next owner and primary action readable before secondary metadata.",
      "Do use citron for review states and retain text labels alongside color.",
      "Do preserve visible keyboard focus and the mobile list-to-detail path."
    ],
    "donts": [
      "Don't spread citron into generic success, decorative accents, or ordinary navigation.",
      "Don't add resting shadows to records or routine cards.",
      "Don't replace aligned, compact records with ornamental tiles where the assistant needs to compare items."
    ]
  }
